Options -Indexes
DirectoryIndex index.php
SetEnvIf Request_URI "^/(proxy|session|bridge)\.php$" isolated_endpoint
SetEnvIf Request_URI "^/(proxy|bridge)\.php$" dontlog

RewriteEngine On
RewriteCond %{HTTP_HOST} ^dualviewurl-view\.jessysystem\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(proxy|session|bridge)\.php$ [NC]
RewriteRule ^ - [R=404,L]
RewriteCond %{HTTP_HOST} !^dualviewurl-view\.jessysystem\.com$ [NC]
RewriteRule ^index\.html$ index.php [END]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN" env=!isolated_endpoint
    Header always unset X-Frame-Options env=isolated_endpoint
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
